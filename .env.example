# Copy to .env.local for local development, and set the same values in the
# Vercel project settings. NEXT_PUBLIC_* values are built into the browser
# bundle, so a change needs a redeploy.

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Every order, payment screenshot, status change and account
# deletion goes through it. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
# Public https URL; receipts link the logo from here.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Shop location (required for delivery) -----------------------------------
# The shop's map pin in decimal degrees. Delivery distances are measured from
# here; without both values the address check refuses every delivery order.
# In Google Maps, right-click the shop's pin and click the coordinates to copy.
NEXT_PUBLIC_BAKERY_LAT=
NEXT_PUBLIC_BAKERY_LNG=
# Optional; shown for pick-up and on receipts. Defaults to the Lipa address.
NEXT_PUBLIC_BAKERY_ADDRESS=

# --- Email (Resend) ------------------------------------------------------------
# Without a key, receipts are skipped and the contact form says messaging is down.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. 2M's Bakery <orders@your-domain.example>
RECEIPT_FROM_EMAIL=
# Where contact-form messages go. Defaults to CONTACT_INBOX_DEFAULT in lib/shop.ts.
CONTACT_TO_EMAIL=

# --- CAPTCHA (Cloudflare Turnstile, optional) ---------------------------------
# Site key from the Cloudflare dashboard. The secret key goes in Supabase, not
# here: Authentication > Attack Protection > Enable CAPTCHA > Turnstile. Set
# both together; with only the Supabase side on, every sign-in fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Address lookup (optional) ---------------------------------------------------
# Nominatim asks callers to identify themselves; include a contact address.
GEOCODER_USER_AGENT=
# Comma-separated ISO country codes to search. Defaults to ph.
GEOCODE_COUNTRY_CODES=
